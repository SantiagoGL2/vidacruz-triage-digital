# Copia este archivo a .env y reemplaza los valores. .env esta en .gitignore: NUNCA lo commitees.
#   cp .env.example .env

# --- PostgreSQL (triage-service) ---
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me-postgres

# --- Redis Stack (clinical-assistant-service) ---
REDIS_PASSWORD=change-me-redis

# --- API keys de los endpoints (header X-API-Key) ---
TRIAGE_API_KEY=change-me-triage-key
ASSISTANT_API_KEY=change-me-assistant-key

# --- Proveedor LLM (OpenAI-compatible). La clave real va SOLO aqui ---
LLM_API_KEY=change-me-llm-key
LLM_BASE_URL=https://api.openai.com
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# RAG (opcional): fragmentos por consulta y similitud minima (0..1, escala de Spring AI: ortogonal = 0.5). Ver docs/asistente-rag.md
# ASSISTANT_RAG_TOP_K=4
# ASSISTANT_RAG_SIMILARITY_THRESHOLD=0.75

# --- Triage: SLA por nivel en minutos (RN-02) e intervalo del scheduler. Reduce para probar escalamiento ---
TRIAGE_SLA_CRITICO=5
TRIAGE_SLA_URGENTE=10
TRIAGE_SLA_URGENTE_2=30
TRIAGE_SLA_NO_URGENTE=60
TRIAGE_SLA_NO_URGENTE_2=120
TRIAGE_SLA_INTERVALO_EVALUACION=PT30S

# --- Alertas de escalamiento (RF-06): webhook opcional (vacio = solo SSE en GET /triage/alertas/stream) ---
TRIAGE_ALERTAS_WEBHOOK_URL=
# Swagger UI y /v3/api-docs (poner false en produccion)
SWAGGER_HABILITADO=true
# Reporte de operacion (RF-05)
TRIAGE_REPORTES_ZONA=America/Bogota
TRIAGE_REPORTES_RANGO_MAXIMO_DIAS=31

# --- Observabilidad (opcional) ---
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
